{
  "name": "catalogo-biani",
  "version": "2.0.0",
  "description": "Catálogo digital profesional responsivo con integración a Google Sheets y WhatsApp",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "node ./scripts/lint_check.js",
    "validate": "npm run lint && npm run test && npm run test:e2e",
    "test:e2e": "playwright test",
    "admin:package:check": "node scripts/apply-admin-package.js --check",
    "admin:package:apply": "node scripts/apply-admin-package.js --apply"
  },
  "keywords": [
    "catalogo",
    "pwa",
    "google-sheets",
    "whatsapp",
    "ecommerce"
  ],
  "author": "BIANI",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
